# Copy this file to .env locally and replace placeholders.
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./smartfarm.db

MQTT_HOST=your-hivemq-host
MQTT_PORT=8883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password
MQTT_TLS=true

WEATHER_API_KEY=your-weather-api-key
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com/version1/messaging
SMS_SENDER_ID=SMARTFARM

FRONTEND_URL=http://localhost:5173
