# Copy this file to .env locally and replace placeholders.
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./smartfarm.db
MQTT_ENABLED=true

MQTT_HOST=25982f992b5d422194eb3edfd0e2d2d1.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=BackendSmartFarm
MQTT_PASSWORD=your-password
MQTT_TLS=true
MQTT_TELEMETRY_TOPIC=smartfarm/+/telemetry
MQTT_COMMAND_TOPIC=smartfarm/{farm_id}/command
MQTT_STATUS_TOPIC=smartfarm/{farm_id}/status
MQTT_ADVISORY_TOPIC=smartfarm/{farm_id}/advisory

WEATHER_API_KEY=your-weather-api-key

SMS_PROVIDER=your-provider
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=SMARTFARM

FRONTEND_URL=http://localhost:5173
